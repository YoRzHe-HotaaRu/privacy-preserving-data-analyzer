# Privacy-Preserving Data Analyzer - Environment Configuration

# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Model Configuration
LLM_MODEL=bytedance-seed/seed-1.6-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# Privacy Parameters
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=0.00001
DEFAULT_K_ANONYMITY=5
DEFAULT_L_DIVERSITY=3
DEFAULT_T_CLOSENESS=0.2

# Database
DATABASE_URL=sqlite:///data/privacy_analyzer.db

# Logging
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
